# Python
__pycache__/
*.pyc
*.pyo

# NOVA runtime files — auto-generated, never commit
shard_index.json
shard_graph.json
summary_index.json
summary_index.md
nova_usage.jsonl
nova_autoresearch.jsonl
shard_access.jsonl

# SQLite databases — runtime artifacts, never commit
skill_audit.db*
nova_shard_index.db*
mcp/nova_shard_index.db*

# SQLite WAL-mode journals — mid-write state, never commit
*.db-shm
*.db-wal

# Shard data — personal, never commit
shards/
nova_sessions/
donors/
intake/

# Output / experiments
output/

# Secrets
.env
.env.local
# Keep .env.example — it's the template
!.env.example

# Binary assets (tracked in docs/ but not committed)
*.pdf
*.pptx

# MCP local config
.mcp.json

# Claude Code local config — user-specific permissions and allowlists
**/.claude/settings.local.json
/.sdd/

# shard_parser facts corpus — user-personal (track examples/ only)
facts/*
!facts/examples/
!facts/examples/**
facts_index.db
