# ── API Keys ─────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...

# ── Model selection ───────────────────────────────────────────────────────────
HUGINN_MODEL=claude-haiku-4-5-20251001
MUNINN_MODEL=claude-sonnet-4-6

# ── Paths (defaults work for local dev; Docker overrides these via ENV) ───────
NOVA_SHARD_DIR=./shards
NOVA_INDEX_FILE=./shard_index.json
NOVA_GRAPH_FILE=./shard_graph.json
NOVA_USAGE_LOG=./nova_usage.jsonl
NOVA_SESSION_STORE_DIR=./nova_sessions
NOVA_SUMMARY_INDEX_FILE=./summary_index.json
NOVA_SUMMARY_MARKDOWN_FILE=./summary_index.md

# ── Retrieval ─────────────────────────────────────────────────────────────────
HUGINN_CONFIDENCE_THRESHOLD=0.7
RAVEN_API_TIMEOUT=10
NOVA_MAX_FRAGMENTS=10

# ── Maintenance policy ────────────────────────────────────────────────────────
NOVA_COMPACT_THRESHOLD=30
NOVA_COMPACT_KEEP=15
NOVA_DECAY_RATE=0.05
NOVA_DECAY_DAYS=7
NOVA_MERGE_THRESHOLD=0.85
NOVA_CONFIDENCE_LOW=0.4
NOVA_RECENT_DAYS=3
NOVA_STALE_DAYS=14
NOTT_COUNT_THRESHOLD=100

# ── Forgemaster ───────────────────────────────────────────────────────────────
# FORGEMASTER_EVENT_LOG=./output/forgemaster_runs/sprint.jsonl
# FORGEMASTER_WRITE_ROOTS=output,intake
# Per-role agents — uncomment and set to swap an individual role without
# rebuilding. Defaults: MUNINN_MODEL (Sonnet) for orchestrator, planner and
# reviewer; HUGINN_MODEL (Haiku) for the implementer. Opus is the recommended
# escalation for orchestrator/reviewer on high-stakes sprints.
# FORGEMASTER_ORCHESTRATOR_MODEL=
# FORGEMASTER_PLANNER_MODEL=
# FORGEMASTER_REVIEWER_MODEL=
# FORGEMASTER_IMPLEMENTER_MODEL=
#
# Provider per role: anthropic (default) or openai_compatible. The same four
# suffixes work for every role prefix: FORGEMASTER_ORCHESTRATOR / _PLANNER /
# _IMPLEMENTER / _REVIEWER, and for the NÓTT adversarial pass (NOVA_ADVERSARIAL).
# Example — run the implementer on a local OpenAI-compatible server:
# FORGEMASTER_IMPLEMENTER_PROVIDER=openai_compatible
# FORGEMASTER_IMPLEMENTER_BASE_URL=http://127.0.0.1:1234/v1
# FORGEMASTER_IMPLEMENTER_MODEL=your-local-model
# FORGEMASTER_IMPLEMENTER_API_KEY_ENV=        # name of an env var holding a key; omit for local servers
# NOVA_PROVIDER_TIMEOUT_S=300

# ── HITL gate ─────────────────────────────────────────────────────────────────
# interactive  — terminal prompt with timeout (local dev only)
# policy       — auto-deny (recommended for Docker / headless)
# Fallback broker for paths with no MCP client to ask (forgemaster file
# writes, bare CLI). MCP tool calls use elicitation.
NOVA_HITL_BROKER=interactive
NOVA_HITL_TIMEOUT_S=30

# ── Tool gating (comma-separated, optional) ───────────────────────────────────
# NOVA_DENIED_TOOLS=nova_evolve,nova_shard_forget
# NOVA_DENIED_PREFIXES=nidhogg
